      "poster": "photos/appsylum25/1.jpg",
      "registration_url": "",
      "rounds": [
        {
          "round": "01",
          "title": "Chaos Kickoff",
          "summary": "An icebreaker, then every team drew a Useless Superpower Card: a quirky constraint like pitching in a funny accent or adding a random object to the presentation."
        },
        {
          "round": "02",
          "title": "Hyperdrive Creation Brawl",
          "summary": "Teams built the full concept: app name and tagline, an app icon, one meme, and a random twist such as Time Increment or Time Decrement."
        },
        {
          "round": "03",
          "title": "Sharkocalypse Pitch Showdown",
          "summary": "Two minutes per team to show the meme, the name and icon, the idea and the twist. Judged on creativity, humour, clarity and use of constraints."
        }
